datasource db { provider = "postgresql" url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }

enum RoleName { SUPER_ADMIN AGENCY_ADMIN MANAGER AGENT CONTENT_EDITOR CUSTOMER }
enum PropertyType { APARTMENT VILLA OFFICE SHOP WAREHOUSE LAND PROJECT }
enum ListingType { BUY RENT COMMERCIAL LAND NEW_PROJECT }
enum PropertyStatus { DRAFT REVIEW APPROVED PUBLISHED RESERVED SOLD RENTED OFF_MARKET ARCHIVED }
enum LeadStatus { NEW CONTACTED QUALIFIED VIEWING_SCHEDULED NEGOTIATING WON LOST ARCHIVED }
enum AppointmentStatus { REQUESTED CONFIRMED RESCHEDULED CANCELLED COMPLETED NO_SHOW }

model Agency {
  id String @id @default(uuid())
  name String
  slug String @unique
  logoUrl String?
  primaryColor String?
  secondaryColor String?
  timezone String @default("Asia/Baku")
  domain String? @unique
  settings Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  properties Property[]
  agents Agent[]
  workingHours WorkingHour[]
}
model User {
  id String @id @default(uuid())
  agencyId String?
  email String @unique
  passwordHash String?
  name String
  phone String?
  locale String @default("en")
  role RoleName @default(CUSTOMER)
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agency Agency? @relation(fields:[agencyId], references:[id], onDelete:SetNull)
  agent Agent?
  favorites Favorite[]
  savedSearches SavedSearch[]
  leads Lead[] @relation("LeadCreator")
  appointments Appointment[] @relation("ClientAppointments")
  auditLogs AuditLog[]
}
model Agent {
  id String @id @default(uuid())
  userId String @unique
  agencyId String
  bio String?
  languages String[]
  specialties String[]
  locations String[]
  photoUrl String?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  agency Agency @relation(fields:[agencyId], references:[id], onDelete:Cascade)
  properties Property[]
  leads Lead[] @relation("AssignedAgent")
  appointments Appointment[] @relation("AgentAppointments")
}
model City { id String @id @default(uuid()); name String; country String; slug String @unique; neighborhoods Neighborhood[]; properties Property[] }
model Neighborhood { id String @id @default(uuid()); cityId String; name String; slug String; description String?; city City @relation(fields:[cityId], references:[id], onDelete:Cascade); properties Property[]; @@unique([cityId,slug]) }
model Property {
  id String @id @default(uuid())
  agencyId String
  cityId String
  neighborhoodId String?
  agentId String?
  slug String @unique
  title String
  description String
  propertyType PropertyType
  listingType ListingType
  status PropertyStatus @default(DRAFT)
  price Decimal @db.Decimal(18,2)
  currency String @default("USD")
  area Decimal @db.Decimal(12,2)
  bedrooms Int @default(0)
  bathrooms Int @default(0)
  floor Int?
  totalFloors Int?
  yearBuilt Int?
  parking Int @default(0)
  furnishing String?
  address String
  latitude Decimal? @db.Decimal(10,7)
  longitude Decimal? @db.Decimal(10,7)
  geometry Unsupported("geometry(Point,4326)")?
  featured Boolean @default(false)
  popularity Int @default(0)
  tags String[]
  features Json?
  energyInfo Json?
  legalStatus String?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agency Agency @relation(fields:[agencyId], references:[id], onDelete:Cascade)
  city City @relation(fields:[cityId], references:[id], onDelete:Restrict)
  neighborhood Neighborhood? @relation(fields:[neighborhoodId], references:[id], onDelete:SetNull)
  agent Agent? @relation(fields:[agentId], references:[id], onDelete:SetNull)
  media PropertyMedia[]
  amenities PropertyAmenity[]
  units PropertyUnit[]
  floorPlans PropertyFloorPlan[]
  prices PriceHistory[]
  statuses StatusHistory[]
  favorites Favorite[]
  views PropertyView[]
  inquiries Inquiry[]
  appointments Appointment[]
  leads Lead[]
  offers Offer[]
  auditLogs AuditLog[]
  @@index([agencyId,status])
  @@index([cityId,neighborhoodId])
  @@index([listingType,propertyType,status])
  @@index([price])
  @@index([area])
}
model PropertyUnit { id String @id @default(uuid()); propertyId String; unitCode String; floor Int?; area Decimal @db.Decimal(12,2); price Decimal? @db.Decimal(18,2); status String @default("AVAILABLE"); bedrooms Int @default(0); bathrooms Int @default(0); view String?; orientation String?; property Property @relation(fields:[propertyId], references:[id], onDelete:Cascade); @@unique([propertyId,unitCode]) }
model PropertyMedia { id String @id @default(uuid()); propertyId String; kind String; url String; objectKey String?; thumbnailUrl String?; alt String?; caption String?; sortOrder Int @default(0); visible Boolean @default(true); processingStatus String @default("READY"); property Property @relation(fields:[propertyId], references:[id], onDelete:Cascade); @@index([propertyId,sortOrder]) }
model PropertyFloorPlan { id String @id @default(uuid()); propertyId String; name String; url String; floor Int?; data Json?; property Property @relation(fields:[propertyId], references:[id], onDelete:Cascade) }
model Amenity { id String @id @default(uuid()); name String; slug String @unique; properties PropertyAmenity[] }
model PropertyAmenity { propertyId String; amenityId String; property Property @relation(fields:[propertyId], references:[id], onDelete:Cascade); amenity Amenity @relation(fields:[amenityId], references:[id], onDelete:Cascade); @@id([propertyId,amenityId]) }
model PriceHistory { id String @id @default(uuid()); propertyId String; price Decimal @db.Decimal(18,2); currency String; reason String?; createdAt DateTime @default(now()); property Property @relation(fields:[propertyId], references:[id], onDelete:Cascade); @@index([propertyId,createdAt]) }
model StatusHistory { id String @id @default(uuid()); propertyId String; fromStatus PropertyStatus?; toStatus PropertyStatus; reason String?; createdAt DateTime @default(now()); property Property @relation(fields:[propertyId], references:[id], onDelete:Cascade); @@index([propertyId,createdAt]) }
model Favorite { userId String; propertyId String; createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete:Cascade); property Property @relation(fields:[propertyId], references:[id], onDelete:Cascade); @@id([userId,propertyId]) }
model SavedSearch { id String @id @default(uuid()); userId String; name String; query Json; enabled Boolean @default(true); lastMatchedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; user User @relation(fields:[userId], references:[id], onDelete:Cascade); @@index([userId,enabled]) }
model PropertyView { id String @id @default(uuid()); propertyId String; userId String?; sessionId String?; source String?; createdAt DateTime @default(now()); property Property @relation(fields:[propertyId], references:[id], onDelete:Cascade); @@index([propertyId,createdAt]) }
model Lead { id String @id @default(uuid()); creatorId String?; agencyId String; assignedAgentId String?; propertyId String?; name String; email String; phone String?; source String?; status LeadStatus @default(NEW); priority String @default("MEDIUM"); budget Decimal? @db.Decimal(18,2); locationPreference String?; nextFollowUp DateTime?; score Int @default(0); notes String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; creator User? @relation("LeadCreator", fields:[creatorId], references:[id], onDelete:SetNull); property Property? @relation(fields:[propertyId], references:[id], onDelete:SetNull); agent Agent? @relation("AssignedAgent", fields:[assignedAgentId], references:[id], onDelete:SetNull); histories LeadStatusHistory[]; notesList LeadNote[]; tasks LeadTask[]; @@index([agencyId,status,priority]) }
model LeadStatusHistory { id String @id @default(uuid()); leadId String; fromStatus LeadStatus?; toStatus LeadStatus; actorId String?; createdAt DateTime @default(now()); lead Lead @relation(fields:[leadId], references:[id], onDelete:Cascade) }
model LeadNote { id String @id @default(uuid()); leadId String; authorId String?; body String; createdAt DateTime @default(now()); lead Lead @relation(fields:[leadId], references:[id], onDelete:Cascade) }
model LeadTask { id String @id @default(uuid()); leadId String; title String; dueAt DateTime?; completedAt DateTime?; lead Lead @relation(fields:[leadId], references:[id], onDelete:Cascade) }
model Appointment { id String @id @default(uuid()); agencyId String; propertyId String; clientId String?; agentId String?; clientName String; clientEmail String; clientPhone String?; startAt DateTime; endAt DateTime; status AppointmentStatus @default(REQUESTED); notes String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; property Property @relation(fields:[propertyId], references:[id], onDelete:Cascade); client User? @relation("ClientAppointments", fields:[clientId], references:[id], onDelete:SetNull); agent Agent? @relation("AgentAppointments", fields:[agentId], references:[id], onDelete:SetNull); @@index([agencyId,startAt,endAt,status]); @@index([propertyId,startAt]) }
model WorkingHour { id String @id @default(uuid()); agencyId String; day String; open Boolean @default(true); start String; end String; slotMinutes Int @default(60); agency Agency @relation(fields:[agencyId], references:[id], onDelete:Cascade); @@unique([agencyId,day]) }
model Inquiry { id String @id @default(uuid()); agencyId String; propertyId String; name String; email String; phone String?; message String; sourceUrl String?; preferredContactTime String?; context Json?; createdAt DateTime @default(now()); property Property @relation(fields:[propertyId], references:[id], onDelete:Cascade) }
model Offer { id String @id @default(uuid()); propertyId String; userId String?; amount Decimal @db.Decimal(18,2); currency String; status String @default("PENDING"); note String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; property Property @relation(fields:[propertyId], references:[id], onDelete:Cascade) }
model AuditLog { id String @id @default(uuid()); agencyId String?; actorId String?; action String; entityType String; entityId String?; requestId String?; ipHash String?; changeSummary Json?; createdAt DateTime @default(now()); actor User? @relation(fields:[actorId], references:[id], onDelete:SetNull); property Property? @relation(fields:[entityId], references:[id], onDelete:SetNull); @@index([agencyId,createdAt]); @@index([entityType,entityId]) }
model Conversation { id String @id @default(uuid()); agencyId String; clientId String?; agentId String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; messages Message[] }
model Message { id String @id @default(uuid()); conversationId String; senderId String; body String; attachmentKey String?; readAt DateTime?; createdAt DateTime @default(now()); conversation Conversation @relation(fields:[conversationId], references:[id], onDelete:Cascade); @@index([conversationId,createdAt]) }
model Notification { id String @id @default(uuid()); userId String; title String; body String; type String; readAt DateTime?; createdAt DateTime @default(now()); }
model BlogPost { id String @id @default(uuid()); agencyId String?; slug String @unique; title String; excerpt String?; content Json; publishedAt DateTime?; locale String @default("en"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Translation { id String @id @default(uuid()); namespace String; key String; locale String; value String; version Int @default(1); @@unique([namespace,key,locale,version]) }
model Setting { id String @id @default(uuid()); agencyId String?; key String; value Json; updatedAt DateTime @updatedAt; @@unique([agencyId,key]) }
model FeatureFlag { id String @id @default(uuid()); key String @unique; enabled Boolean @default(false); rules Json?; updatedAt DateTime @updatedAt }
